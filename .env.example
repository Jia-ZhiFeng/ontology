POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=credit_ontology
POSTGRES_USER=credit
POSTGRES_PASSWORD=credit123
NEBULA_HOST=graphd
NEBULA_PORT=9669
NEBULA_USER=root
NEBULA_PASSWORD=nebula
NEBULA_SPACE=credit_ontology
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:4173,http://127.0.0.1:4173
MVP_API_KEY=replace-with-a-long-random-token
# Local desktop default: the browser receives a short HttpOnly session and does
# not need the MVP_API_KEY. Set api_key for remote/server deployments.
MVP_AUTH_MODE=local_session
# Optional dedicated HMAC secret (32+ bytes). Local mode may fall back to
# MVP_API_KEY; remote/production deployments should always set it independently.
MVP_LOCAL_SESSION_SECRET=
MVP_LOCAL_SESSION_TTL_SECONDS=900
# Enable only behind the loopback-bound Docker ports in docker-compose.yml.
MVP_LOCAL_SESSION_TRUST_PROXY=true
MVP_LOCAL_SESSION_COOKIE_SECURE=false
MVP_LOCAL_SESSION_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:4173,http://127.0.0.1:4173
# UAT only: exposes exact deterministic read-only routes; external LLM and writes still require X-API-Key.
WORKBENCH_UNAUTHENTICATED=false
# Agent runtime rollout switch. Keep legacy until the ontology_agent runtime is
# implemented and explicitly enabled by a later migration phase.
PERSONAL_CREDIT_AGENT_MODE=legacy
MVP_ACTION_ACTOR_ID=mvp-local-operator
MVP_ACTION_ACTOR_ROLE=风控专员
MVP_CREATE_APPLICATION_ACTOR_ID=mvp-origination-adapter
MVP_CREATE_APPLICATION_ACTOR_ROLE=系统适配器
MVP_CREDIT_REPORT_ACTOR_ID=mvp-credit-adapter
MVP_CREDIT_REPORT_ACTOR_ROLE=系统适配器
# Production stays fail-closed until real consent/provider adapters are configured.
CREDIT_PROVIDER_MODE=disabled
CREDIT_CONSENT_MODE=disabled
# Local demo only: set both modes to sandbox and use SANDBOX-CONSENT:<application_id>.
CREDIT_SANDBOX_CONSENT_PREFIX=SANDBOX-CONSENT:
MVP_FRAUD_REPORT_ACTOR_ID=mvp-fraud-adapter
MVP_FRAUD_REPORT_ACTOR_ROLE=系统适配器
# Local demo only: set to sandbox. Production remains fail-closed by default.
FRAUD_PROVIDER_MODE=disabled
MVP_PHONE_TASK_ACTOR_ID=mvp-phone-task-adapter
MVP_PHONE_TASK_ACTOR_ROLE=系统适配器
# Local demo only: set to sandbox. A disabled dispatcher retains the task as pending.
PHONE_TASK_DISPATCH_MODE=disabled
MVP_PHONE_RESULT_ACTOR_ID=mvp-phone-result-adapter
MVP_PHONE_RESULT_ACTOR_ROLE=数字人适配器
MVP_MANUAL_REVIEW_ACTOR_ID=mvp-manual-review-router
MVP_MANUAL_REVIEW_ACTOR_ROLE=系统适配器
MVP_DECISION_RECOMMENDATION_ACTOR_ID=mvp-risk-manager
MVP_DECISION_RECOMMENDATION_ACTOR_ROLE=风险经理
MVP_OUTBOX_OPERATOR_ID=mvp-outbox-operator
MVP_OUTBOX_OPERATOR_ROLE=系统运维
MVP_WORKFLOW_ACTOR_ID=mvp-workflow-orchestrator
MVP_WORKFLOW_ACTOR_ROLE=系统适配器
WORKFLOW_DISPATCH_LEASE_SECONDS=120
OPERATIONS_SCAN_SECONDS=15
ALERT_ESCALATION_SECONDS=900
ALERT_NOTIFICATION_COOLDOWN_SECONDS=300
EXTERNAL_CIRCUIT_FAILURE_THRESHOLD=3
EXTERNAL_CIRCUIT_OPEN_SECONDS=60
# Optional outbound notification. Disabled means alerts remain in PostgreSQL/UI only.
ALERT_WEBHOOK_ENABLED=false
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT_SECONDS=5
ALERT_WEBHOOK_ALLOW_INSECURE_LOCAL=false
ACTION_OUTBOX_MAX_ATTEMPTS=5
ACTION_OUTBOX_LEASE_SECONDS=60
ACTION_OUTBOX_POLL_SECONDS=5
ACTION_OUTBOX_RETRY_BASE_SECONDS=5
ACTION_OUTBOX_RETRY_MAX_SECONDS=300
LLM_ALLOWED_BASE_URLS=https://api.openai.com/v1
LLM_ALLOW_INSECURE_LOCAL=false
# Optional dedicated passphrase for PostgreSQL pgcrypto. In local MVP mode the
# backend falls back to MVP_API_KEY; production deployments should set an
# independent strong secret so rotating the workbench token does not affect
# stored model credentials.
LLM_CONFIG_ENCRYPTION_KEY=
LLM_REQUEST_TIMEOUT_SECONDS=60
